{
  "name": "humanitic-macro-prompt-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first app that distills text into reusable nano-snippets (concept + intent) and a lab to build your own macro-prompts, with filtering you control.",
  "engines": { "node": ">=23" },
  "bin": { "mpl": "src/cli.ts" },
  "scripts": {
    "start": "node src/service.ts",
    "app": "node src/service.ts",
    "mpl": "node src/cli.ts",
    "demo": "node src/cli.ts demo",
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
