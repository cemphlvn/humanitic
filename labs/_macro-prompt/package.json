{
  "name": "humanitic-macro-prompt-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first lens that distills macro-prompts into reusable nano-snippets (concept + intent), gated by assumptions, positioned in an ontology graph.",
  "engines": { "node": ">=23" },
  "bin": { "mpl": "src/cli.ts" },
  "scripts": {
    "mpl": "node src/cli.ts",
    "learn": "node src/cli.ts learn",
    "experiment": "node src/cli.ts experiment",
    "contribute": "node src/cli.ts contribute",
    "demo": "node src/cli.ts demo",
    "typecheck": "tsc --noEmit"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.70.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  }
}
